# Copy to server/.env and fill in real values. NEVER commit real secrets.
MONGODB_URI=mongodb+srv://creaticodedev_db_user:Zakaria1234561@cluster0.h8gvhvx.mongodb.net/kririder?appName=Cluster0@cluster0.h8gvhvx.mongodb.net/kririder?appName=Cluster0
# Must be ≥32 characters in production (server refuses to start otherwise)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
CLIENT_URL=https://www.example.com,https://example.com
PORT=3000
NODE_ENV=production
# TRUST_PROXY=true

# ImageKit (required for car/profile image uploads)
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Optional agency admin seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeStrongPassword!
ADMIN_NAME=Admin

# Platform Super Admin (dedicated /superadmin login — never share with agency admins)
# Seed with: npm run seed:superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ChangeMeStrongPassword!
SUPERADMIN_NAME=Super Admin

# Trial / license (legacy User.license* — dual-written from AgencySubscription in P4)
TRIAL_DAYS=7
# P4 SaaS billing
# BILLING_ENFORCEMENT=true
# BILLING_GRACE_DAYS=7
# STRIPE_BILLING_ENABLED=false

# Agency owner onboarding invite TTL (days). Raw token is never stored — only SHA-256 hash.
# ONBOARDING_TOKEN_DAYS=7

# P3 public tenancy — platform subdomain + custom domains
# Example: atlas-drift.kririder.com → Agency.slug=atlas-drift
PLATFORM_BASE_DOMAIN=kririder.com
# STOREFRONT_URL_PROTOCOL=https
# DOMAIN_DNS_VERIFY=true
# DOMAIN_ALLOW_TEST_VERIFY=false
# DNS CNAME target shown to owners (documentation only):
# sites.kririder.com

# P1 public storefront tenant resolution
# - Per-agency storefronts: /s/{agency-slug} (X-Agency-Slug / ?agency=) — always supported
# - Subdomain / custom domain Host resolution (P3) takes priority when present
# - Single-agency deploy default `/`: leave both unset (auto-resolves the only active agency)
# - Multi-agency default `/` (kririder.com apex): REQUIRED on api.kririder.com
#   Also set matching client build vars (Vercel):
#     VITE_PLATFORM_BASE_DOMAIN=kririder.com
#     VITE_DEFAULT_STOREFRONT_SLUG=<same agency slug>
#   Run: npm run diagnose:public-tenant — prints recommended values from your DB
# - Legacy compat: PUBLIC_OWNER_ID maps via Agency.legacyOwnerId
# PUBLIC_AGENCY_ID=507f1f77bcf86cd799439011
# PUBLIC_OWNER_ID=507f1f77bcf86cd799439011

# Platform identity (Super Admin / trial / system messages — NOT tenant storefronts)
PLATFORM_NAME=RSZ CAR
# PLATFORM_SUPPORT_EMAIL=support@example.com
# PLATFORM_SUPPORT_WHATSAPP=212600000000

# WhatsApp — wa.me only (no Meta/Twilio API). Prefer Admin → Settings / Agency branding.
# Env dial is ops fallback only when agency has no WhatsApp configured.
WHATSAPP_BUSINESS_NUMBER=212600000000
WHATSAPP_CURRENCY=MAD

# Optional currency default (agency.currency overrides on tenant surfaces)
CURRENCY=MAD
API_PUBLIC_URL=https://api.example.com
COMPLETION_TOKEN_DAYS=7
DEPOSIT_PERCENT=30

# Email (SMTP) — REQUIRED for completion & final confirmation emails
# Display name / Reply-To come from agency branding when sending tenant mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=RSZ CAR <noreply@example.com>
# SMTP_DEBUG=true
# SMTP_ALLOW_CUSTOM_FROM=false

# Online payments — Stripe in production. Demo requires BOTH:
# PAYMENT_MODE=demo and ALLOW_DEMO_PAYMENT=true (never enable demo in production).
PAYMENT_MODE=stripe
PAYMENT_CURRENCY=mad
STRIPE_SECRET_KEY=sk_live_xxx
# ALLOW_DEMO_PAYMENT=true
# Break-glass: allow owner to force ready_for_pickup without completion (default off)
# ALLOW_FORCE_BOOKING_STATUS=true

# Puppeteer / Chrome (PDF contracts & invoices)
# On Render, Chrome must live in the project tree (see server/.puppeteerrc.cjs).
# Build must run: npm run install:chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# PUPPETEER_CACHE_DIR=/opt/render/project/src/.cache/puppeteer
# PDF_MAX_CONCURRENCY=2
# PDF_BROWSER_IDLE_MS=0
