# API origin only — do NOT append /api (client paths already include /api/...).
# In dev you can leave this unset: Vite proxies /api → http://localhost:3000
# Canonical name used by the client (also accepted: VITE_BASE_URL legacy alias).
VITE_API_URL=https://api.kririder.com
VITE_CURRENCY=MAD
VITE_WHATSAPP_BUSINESS_NUMBER=212665330116

# P3 platform host — required so kririder.com apex is the RSZ CAR marketing site
VITE_PLATFORM_BASE_DOMAIN=kririder.com
# Optional sales contact (opens mailto / WhatsApp from the marketing contact form)
# VITE_PLATFORM_SUPPORT_EMAIL=hello@kririder.com
# VITE_PLATFORM_SUPPORT_WHATSAPP=212600000000
# Google Analytics 4 (public Measurement ID — safe in the client bundle)
VITE_GA_MEASUREMENT_ID=G-M4SR5C4KGH
# Set true locally to force GA4 debug_mode (also enabled with ?debug_mode=1)
# VITE_GA_DEBUG=true
